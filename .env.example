APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Shopee Open Platform (open.shopee.com → App List → your app)
SHOPEE_ENV=sandbox
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
# Must match the Redirect URL Domain registered in the Shopee console
SHOPEE_REDIRECT_URL=
# Public HTTPS URL for Live Push, e.g. https://xxxx.trycloudflare.com/api/shopee/push
SHOPEE_PUSH_URL=
FRONTEND_URL=http://localhost:3000

BINDERBYTE_API_KEY=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@pesanin.test

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SIGNATURE_KEY=
MIDTRANS_PRODUCTION=false

SERPAPI_KEY=
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=

META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_CHAT_CONFIG_ID=
META_GRAPH_VERSION=v27.0

# Public HTTPS base for WhatsApp webhooks (tunnel or live domain)
WHATSAPP_WEBHOOK_BASE=
